# Build output and Gradle/Loom scratch. None of it is a source of truth: `build/` is regenerated by
# `./gradlew build`, `.gradle-dist/` by the gradlew bootstrap, and `.classpath`/`.project` by the
# Eclipse plugin that build.gradle applies.
build/
.gradle/
.gradle-dist/
.gradle-cache/
out/
bin/
run/
run-server/
*.class
*.log
*.launch
.settings/
.idea/
*.iml
*.ipr
*.iws
.vscode/
.factorypath
.classpath
.project

# The jar fetched back from the `build-artifacts` branch, so the built mod can sit next to the
# sources without pretending to be one. The canonical copies are the Actions artifact and that
# branch; this is a scratch copy and nothing should ever diff it.
artifacts/
