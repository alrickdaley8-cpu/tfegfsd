;==============================================================================
; Saturn.air — animation definitions
;==============================================================================
; Element syntax:  group, image, x-offset, y-offset, time[, flip[, blend[, x,y scale]]]
;   time = -1 on the last element means "hold this frame forever".
;   "A" blend = additive (used for glows / aura / impact effects).
;   Loopstart begins a loop that repeats the elements after it.
;
; Sprite layout (Saturn.sff):
;   group 0   = character body frames   (see DESIGN.md for the pose index)
;   group 100 = effects (slash/orb/ring/impact/aura/smoke/beam/spark/flash)
;
; Body frames share one fixed canvas with the axis at (64,160), so frames
; never jitter between animations.
;==============================================================================

;------------------------------------------------------------------------------
; 0 : Standing (breathing loop)
;------------------------------------------------------------------------------
[Begin Action 0]
0,0, 0,0, 80
Loopstart
0,1, 0,0, 12
0,0, 0,0, 12
0,1, 0,0, 12

; 5 : Standing turn (finite)
[Begin Action 5]
0,0, 0,0, 6

; 6 : Crouch turn (finite)
[Begin Action 6]
0,4, 0,0, 6

