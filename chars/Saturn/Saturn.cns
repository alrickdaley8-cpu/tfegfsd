;==============================================================================
; Saturn.cns — base data / physics constants
;==============================================================================
; Boss archetype: high health and durability, strong normals, large range,
; but a slow walk and long recoveries on heavy moves. See DESIGN.md for the
; full frame data table.

[Data]
life            = 1150
power           = 3000
attack          = 100
defence         = 100
fall.defence_up = 50
liedown.time    = 60
airjuggle       = 15
sparkno         = -1        ; disable engine hit sparks; we spawn our own VFX
guard.sparkno   = -1
ko.echo         = 0
intpersistindex = 60
floatpersistindex = 40

[Size]
xscale   = 1
yscale   = 1
ground.back  = 16
ground.front = 16
air.back     = 12
air.front    = 12
height       = 60
attack.dist  = 170
proj.attack.dist = 90
proj.doscale = 0
head.pos     = -5, -92
mid.pos      = -5, -60
shadowoffset = 0
draw.offset  = 0,0

[Velocity]
walk.fwd  = 2.3
walk.back = -2.1
run.fwd   = 4.6, 0
run.back  = -3.8,-3.8
jump.neu  = 0,-8.4
jump.back = -2.55
jump.fwd  = 2.5
runjump.back = -2.55,-8.1
runjump.fwd  = 4.0,-8.1
airjump.neu  = 0,-8.1
airjump.back = -2.55
airjump.fwd  = 2.5

[Movement]
airjump.num    = 1
airjump.height = 35
yaccel         = 0.44
stand.friction    = 0.85
crouch.friction   = 0.82
